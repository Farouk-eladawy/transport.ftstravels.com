# TourCare Transport — transport.tourcare.ai
# Copy to .env on the server before docker compose up -d
# Generate secrets: openssl rand -base64 64

# ── Domain / branding ──
DOMAIN=transport.tourcare.ai
APP_HOST=transport.tourcare.ai
FRONTEND_URL=https://transport.tourcare.ai
PUBLIC_BACKEND_URL=https://transport.tourcare.ai
PUBLIC_SITE_URL=https://transport.tourcare.ai

# CRM dashboard that will embed or call this system (add all origins you use)
CORS_ORIGINS=https://transport.tourcare.ai,https://tourcare.ai,https://www.tourcare.ai,https://api.ftstravels.com

# Leave empty when nginx serves /api on the same domain (recommended)
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://backend:3001

# ── Database ──
POSTGRES_USER=tourcare_transport
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tourcare_transport
POSTGRES_PORT=5433

# ── JWT (required) ──
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
NODE_ENV=production
TZ=Africa/Cairo
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── CRM bridge (FTS / TourCare calls POST /api/partner/* with this key) ──
PARTNER_API_KEY=CHANGE_ME_LONG_RANDOM_KEY

# ── License server (required in production builds of this project) ──
LICENSE_SERVER_URL=https://ilicense.tech
LICENSE_PUBLIC_KEY=

# ── Frontend feature flags ──
NEXT_PUBLIC_ENABLE_CAR_DISPATCH=true

# ── Optional: Google Maps (locations / geofence UI) ──
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Optional: AI job import (Gemini) ──
GEMINI_API_KEY=

# ── Optional: email (password reset, notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tourcare.ai

# ── Optional: mobile push ──
FIREBASE_SERVICE_ACCOUNT=

# ── Optional: captcha on public forms ──
TURNSTILE_SECRET=

# ── Optional: B2C public booking site (only if you enable guest booking later) ──
B2C_SITE_URL=https://transport.tourcare.ai
GETPAYIN_BASE_URL=https://pay.getpayin.com
GETPAYIN_AUTH_TOKEN=
GETPAYIN_HASH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CRM-side variables (set in ai_agent.py / Railway, NOT in this repo) ──
# TRANSPORT_API_URL=https://transport.tourcare.ai
# TRANSPORT_PARTNER_KEY=same value as PARTNER_API_KEY above
