{
  "_comment": "Copy values into Railway → Service → Variables. Replace CHANGE_ME_* placeholders.",
  "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
  "NODE_ENV": "production",
  "TZ": "Africa/Cairo",
  "APP_HOST": "transport.ftstravels.com",
  "PUBLIC_BACKEND_URL": "https://transport-ftstravels.up.railway.app",
  "CORS_ORIGINS": "https://transport.ftstravels.com,https://api.ftstravels.com",
  "JWT_SECRET": "CHANGE_ME_openssl_rand_base64_64",
  "JWT_REFRESH_SECRET": "CHANGE_ME_openssl_rand_base64_64",
  "JWT_EXPIRES_IN": "15m",
  "JWT_REFRESH_EXPIRES_IN": "7d",
  "PARTNER_API_KEY": "CHANGE_ME_long_random_key_same_in_crm",
  "FTS_STANDALONE": "true",
  "GEOCODING_PROVIDER": "nominatim",
  "NOMINATIM_USER_AGENT": "FTS-Transport/1.0 (transport.ftstravels.com)",
  "RUN_DB_SEED": "true",
  "_run_db_seed_note": "Set RUN_DB_SEED=true only on first deploy, then remove or set false",
  "_netlify_frontend": {
    "NEXT_PUBLIC_API_URL": "https://transport-ftstravels.up.railway.app",
    "NEXT_PUBLIC_ENABLE_CAR_DISPATCH": "true",
    "NEXT_PUBLIC_FTS_STANDALONE": "true"
  },
  "_crm_env": {
    "TRANSPORT_API_URL": "https://transport-ftstravels.up.railway.app",
    "TRANSPORT_PARTNER_KEY": "same as PARTNER_API_KEY",
    "TRANSPORT_FRONTEND_URL": "https://transport.ftstravels.com"
  },
  "_default_admin_after_seed": {
    "email": "admin@itour.local",
    "password": "Admin@123"
  }
}
