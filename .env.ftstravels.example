# FTS Transport — transport.ftstravels.com
# Copy to .env on the server before: docker compose up -d --build
# Generate secrets: openssl rand -base64 64

# ── Domain / branding ──
DOMAIN=transport.ftstravels.com
APP_HOST=transport.ftstravels.com
FRONTEND_URL=https://transport.ftstravels.com
PUBLIC_BACKEND_URL=https://transport.ftstravels.com
PUBLIC_SITE_URL=https://transport.ftstravels.com

# CRM dashboard + API that will embed or call this system
CORS_ORIGINS=https://transport.ftstravels.com,https://ftstravels.com,https://www.ftstravels.com,https://api.ftstravels.com

# Leave empty when nginx serves /api on the same domain (recommended)
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://backend:3001

# ── Database ──
POSTGRES_USER=fts_transport
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fts_transport
POSTGRES_PORT=5433

# ── JWT (required) ──
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ── App ──
NODE_ENV=production
TZ=Africa/Cairo
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── CRM bridge (FTS CRM calls POST /api/partner/* with this key) ──
PARTNER_API_KEY=CHANGE_ME_LONG_RANDOM_KEY

# ── License server (required in production builds of this project) ──
LICENSE_SERVER_URL=https://ilicense.tech
LICENSE_PUBLIC_KEY=

# ── Frontend feature flags ──
NEXT_PUBLIC_ENABLE_CAR_DISPATCH=true

# ── Geocoding (free — OpenStreetMap Nominatim, no API key) ──
GEOCODING_PROVIDER=nominatim
NOMINATIM_USER_AGENT=FTS-Transport/1.0 (transport.ftstravels.com)

# Optional legacy fallback only if you still have a Google key in Settings:
# GEOCODING_PROVIDER=google
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Optional: AI job import (Gemini) ──
GEMINI_API_KEY=

# ── Optional: email (password reset, notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ftstravels.com

# ── Optional: mobile push ──
FIREBASE_SERVICE_ACCOUNT=

# ── Optional: captcha on public forms ──
TURNSTILE_SECRET=

# ── Optional: B2C public booking site (only if you enable guest booking later) ──
B2C_SITE_URL=https://transport.ftstravels.com
GETPAYIN_BASE_URL=https://pay.getpayin.com
GETPAYIN_AUTH_TOKEN=
GETPAYIN_HASH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CRM-side variables (set in ai_agent.py / Railway — NOT in this repo) ──
# TRANSPORT_API_URL=https://transport.ftstravels.com
# TRANSPORT_PARTNER_KEY=same value as PARTNER_API_KEY above
